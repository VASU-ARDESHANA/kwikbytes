{
	"extends": "astro/tsconfigs/strict",
	"include": [
		".astro/types.d.ts",
		"**/*",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"dist"
	],
	"compilerOptions": {
		"strictNullChecks": true,
		"allowJs": true,
		"moduleResolution": "Bundler",
		"module": "ESNext",
		"baseUrl": ".",
		"paths": {
			"~/*": [
				"src/*"
			]
		}
	}
}