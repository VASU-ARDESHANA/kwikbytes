---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/Hero.astro";
import Article from "~/components/Article.astro";
import Badge from "~/components/Badge.astro";
import ButtonCallUs from "~/components/ButtonCallUs.astro";
import ButtonCallSumitBhai from "~/components/ButtonCallSumitBhai.astro";
import { phone, sumitBhaiNumber } from "~/data/config";
import Brahmani from "~/assets/brahmani.png";
import Brahmani_black from "~/assets/brahmani_black.png";
import { Picture, Image } from "astro:assets";
---

<Layout
    title="Catering & Party Orders"
    pageTitle="Catering"
    description="Catering and party orders by KwikBytes – perfect for events, celebrations, and corporate gatherings."
>
	<Section class:list={"bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-orange-50 via-white to-white relative z-10"}>
		<Hero>
			<div slot="hero-content-right" class="relative">
				<div class="absolute inset-0 bg-brand-orange/10 rounded-[3rem] blur-2xl -z-10 transform scale-90 animate-pulse"></div>
				<Picture
					class:list={"mx-auto drop-shadow-2xl animate-float"}
					src={Brahmani_black}
					height={500}
					formats={["avif", "webp"]}
					alt="Brahmani Catering Logo"
					loading={"eager"}
					fetchpriority={"high"}
				/>
			</div>
			<div slot="hero-content-left" class="prose max-w-none relative z-10">
				<Badge title="A venture of Brahmani Catering" color="orange" />
				<h1 class="font-black text-5xl lg:text-7xl leading-tight tracking-tight mt-4 mb-6">
					Catering & <br/>
					<span class="text-brand-orange">Party Orders</span>
				</h1>

				<p class="text-lg text-gray-600 font-medium leading-relaxed max-w-lg mb-8">
					Planning a party, event, or office gathering? KwikBytes
					brings flavor to your celebration with customizable catering
					and bulk orders. From quick bites to full meals, we serve
					food that keeps people coming back for seconds.
				</p>

				<div class="flex flex-wrap gap-4">
					<ButtonCallSumitBhai
						number="9998799971"
						label="Call Sumit"
					/>
					<ButtonCallUs number="7383023407" label="Call Ankit" />
				</div>
			</div>
		</Hero>
	</Section>

    <!-- Catering Details -->
	<Section class:list={"bg-white border-t border-gray-100"}>
		<div class="container mx-auto px-4 max-w-6xl">
			
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
				
				<!-- Left Text Column -->
				<div class="lg:col-span-7 prose prose-lg prose-headings:font-black prose-headings:text-gray-800 prose-p:text-gray-600 prose-p:font-medium prose-li:font-medium">
					<h2 class="text-3xl lg:text-4xl text-brand-green mb-6">Our Services</h2>
					<p class="mb-8">
						We offer both <strong>premium catering</strong> and <strong>party bulk orders</strong> for small gatherings and large events alike. Whether it’s a birthday, wedding function, office meeting, or family celebration, our menu is incredibly flexible and designed to please every palate.
					</p>

					<div class="bg-teal-50/50 p-8 rounded-3xl border border-teal-100 mb-10 shadow-sm">
						<h3 class="text-2xl mb-4 text-brand-green mt-0">Cafe & High-Tea Menu</h3>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-gray-700 mb-6 font-medium">
							<div class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-brand-orange"></div>Tea & Coffee</div>
							<div class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-brand-orange"></div>Thick Shakes & Lassi</div>
							<div class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-brand-orange"></div>Loaded Fries</div>
							<div class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-brand-orange"></div>Gujarati Thepla</div>
							<div class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-brand-orange"></div>Cheesy Maggi</div>
							<div class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-brand-orange"></div>Grill Sandwiches</div>
						</div>
						
						<h3 class="text-2xl mb-4 text-brand-green">Full Catering & Events</h3>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-gray-700 font-medium">
							<div class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-brand-green"></div><strong>Premium Gujarati Thali</strong></div>
							<div class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-brand-green"></div><strong>Authentic Punjabi Cuisine</strong></div>
							<div class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-brand-green"></div><strong>Kathiyawadi Specials</strong></div>
							<div class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-brand-green"></div><strong>Wedding Buffets</strong></div>
							<div class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-brand-green"></div><strong>Corporate Lunch Boxes</strong></div>
							<div class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-brand-green"></div><strong>Live Counters & Chat</strong></div>
						</div>
					</div>

					<h3 class="text-2xl text-gray-800 mb-4">Why Choose KwikBytes Catering?</h3>
					<ul class="mb-10 text-gray-600 space-y-2">
						<li>Guaranteed freshly prepared food for every single order.</li>
						<li>Perfectly portioned for parties, events, and corporate gatherings.</li>
						<li>Highly flexible menu options customized perfectly to your needs.</li>
						<li>Backed by the decades of experience of Brahmani Catering.</li>
					</ul>

					<div class="not-prose">
						<div class="p-6 bg-orange-50 border border-orange-100 rounded-2xl shadow-sm">
							<h3 class="text-xl font-bold mb-3 text-brand-orange mt-0">Place Your Order</h3>
							<p class="text-base font-medium text-gray-600 mb-4">
								To discuss menu options, quantities, and bulk pricing discounts, please call our management team directly:
							</p>
							<div class="flex flex-col sm:flex-row gap-4 sm:gap-8">
								<a href={sumitBhaiNumber.href} class="text-brand-green no-underline hover:no-underline hover:text-brand-orange font-bold text-lg transition-colors flex items-center gap-2">
									<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
									Sumit Jethwa
								</a>
								<a href={phone.href} class="text-brand-green no-underline hover:no-underline hover:text-brand-orange font-bold text-lg transition-colors flex items-center gap-2">
									<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
									Ankit Jethwa
								</a>
							</div>
						</div>
					</div>
				</div>

				<!-- Right PDF Column -->
				<div class="lg:col-span-5 sticky top-24">
					<div class="bg-gray-50 rounded-3xl p-4 sm:p-6 border border-gray-200 shadow-xl relative group overflow-hidden">
						<!-- Decorative header for the PDF -->
						<div class="flex items-center justify-between mb-4 px-2">
							<span class="font-black text-xs text-gray-400 uppercase tracking-widest">Digital Menu</span>
							<div class="flex gap-1.5">
								<div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
								<div class="w-2.5 h-2.5 rounded-full bg-amber-400"></div>
								<div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
							</div>
						</div>

						<!-- THE PDF VIEWER (Now completely responsive and visible on mobile) -->
						<div class="aspect-[3/4] w-full rounded-2xl overflow-hidden bg-white shadow-inner border border-gray-200 mb-6 group-hover:shadow-2xl transition-shadow duration-300">
							<iframe
								src="https://drive.google.com/file/d/1mqqlGDV4vxjIJvq0Kh8hPx4x1Uq3hsSZ/preview"
								class="w-full h-full"
								loading="lazy"
								allow="autoplay"></iframe>
						</div>

						<a
							href="https://drive.google.com/uc?export=download&id=1mqqlGDV4vxjIJvq0Kh8hPx4x1Uq3hsSZ"
							target="_blank"
							rel="noopener"
							class="w-full flex items-center justify-center gap-3 rounded-xl bg-brand-orange px-6 py-4 text-sm sm:text-base font-black uppercase tracking-wider text-white shadow-lg hover:bg-orange-600 hover:-translate-y-1 hover:shadow-xl transition-all active:scale-95"
						>
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
							Download PDF Menu
						</a>
					</div>
				</div>

			</div>
		</div>
	</Section>
</Layout>
