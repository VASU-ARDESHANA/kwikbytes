---
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Heading from "~/components/Heading.astro";
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";

const gallery = await getCollection("gallery");
const getImageSrc = (image?: string | { src?: string }) =>
	typeof image === "string" ? image : image?.src;
---

<Layout
	title="Gallery"
	pageTitle="Gallery"
	description="Explore our gallery to see the ambiance of our restaurant and the delicious dishes we offer."
>
	<Section class:list={"[&>.container]:pb-0"}>
		<Heading>
			<h1 slot="heading-title" class="font-black text-brand-green h2">
				Gallery
			</h1>
			<p slot="heading-content">
				Get a feel of our restaurant and food through our gallery. We
				promise a memorable culinary experience.
			</p>
		</Heading>
	</Section>
	<!-- Stunning Masonry Gallery -->
	<div class="max-w-7xl mx-auto px-4 columns-2 md:columns-3 lg:columns-4 gap-4 space-y-4 pb-16 lg:pb-32">
		{
			gallery.map((item, index) => (
				<div class="break-inside-avoid relative overflow-hidden rounded-2xl shadow-sm hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-1 group bg-gray-100">
					<a href={getImageSrc(item.data.image)} class="glightbox block w-full h-full relative">
						{/* Overlay Effects */}
						<div class="absolute inset-0 bg-brand-green/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
						<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
						
						{/* Text & Underline content */}
						<div class="absolute bottom-0 left-0 right-0 p-5 translate-y-6 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 z-20 pointer-events-none flex flex-col justify-end">
							<p class="text-white font-black text-lg sm:text-xl drop-shadow-lg leading-tight">{item.data.alt || 'KwikBytes Spl.'}</p>
							<div class="w-10 h-1.5 bg-brand-orange mt-3 rounded-full shadow-[0_0_10px_rgba(217,119,6,0.8)]"></div>
						</div>

						{/* Image */}
						<Picture
							src={item.data.image}
							alt={item.data.alt}
							inferSize={true}
							class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700 block"
							loading={index < 4 ? "eager" : "lazy"}
							fetchpriority={index < 4 ? "high" : "auto"}
						/>
					</a>
				</div>
			))
		}
	</div>
	<Section class:list={"[&>.container]:pb-0"}>
		<Heading>
			<p slot="heading-content">
				*Images are for illustrative purposes only and may not reflect
				actual dishes or ambiance.
			</p>
		</Heading>
	</Section>
</Layout>

<script>
	import GLightbox from "glightbox";
	import "../../node_modules/glightbox/dist/css/glightbox.min.css";

	document.addEventListener("astro:page-load", () => {
		const lightbox = GLightbox({
			touchNavigation: true,
			autoplayVideos: true,
			loop: true,
			draggable: true,
		});
	});
</script>
