---
import { getCollection } from "astro:content";
const allReviews = await getCollection("reviews");
---

<div class="swiper w-full mt-8 text-gray-800">
	<div class="swiper-wrapper h-auto w-auto pt-8 pb-12">
		{
			allReviews.map((review) => (
				<div class="swiper-slide cursor-pointer select-none">
					<div class="px-4 lg:px-8">
						<blockquote class="border-none flex flex-col items-center">
							<div class="flex gap-1 text-orange-400 mb-4 justify-center">
								{Array.from({ length: review.data.rating || 5 }).map(() => (
									<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
								))}
							</div>
							<p class="text-center font-medium text-2xl text-balance">{review.data.review}</p>
							<footer class="text-center mt-6 text-gray-500 font-bold tracking-wide">
								— <cite>{review.data.author}</cite>
							</footer>
						</blockquote>
					</div>
				</div>
			))
		}
	</div>
	<div class="swiper-pagination"></div>
</div>

<script>
	import Swiper from "swiper";
	import { Pagination, Autoplay } from "swiper/modules";
	import "swiper/css";
	import "swiper/css/pagination";

	document.addEventListener("astro:page-load", () => {
		const swiper = document.querySelector(".swiper") as HTMLElement;
		new Swiper(swiper, {
			modules: [Pagination, Autoplay],
			loop: true,
			slidesPerView: 1,
			spaceBetween: 32,
			autoplay: {
				delay: 2500,
			},
			pagination: {
				el: ".swiper-pagination",
			},
		});
	});
</script>
