---
const { color = "green", title = "" }: BadgeProps = Astro.props;

interface BadgeProps {
	color?: "red" | "green";
	title?: string;
}

const colors = {
	red: "bg-brand-red/10 text-brand-red ring-1 ring-brand-red/30 shadow-sm shadow-brand-red/10",
	green: "bg-brand-green/10 text-brand-green ring-1 ring-brand-green/30 shadow-sm shadow-brand-green/10",
	white: "bg-white shadow-sm ring-1 ring-gray-200",
	black: "bg-brand-black/10 text-brand-black ring-1 ring-brand-black/30 shadow-sm shadow-brand-black/10",
	yellow: "bg-brand-yellow/10 text-brand-yellow ring-1 ring-brand-yellow/30 shadow-sm shadow-brand-yellow/10",
	blue: "bg-brand-blue/10 text-brand-blue ring-1 ring-brand-blue/30 shadow-sm shadow-brand-blue/10",
	orange: "bg-brand-orange/10 text-[#db1d00] ring-1 ring-brand-orange/30 shadow-sm shadow-brand-orange/20 bg-gradient-to-r from-brand-orange/10 to-brand-red/10",
};
---

<span class={`inline-flex not-prose items-center mb-6 rounded-full px-4 py-1.5 text-sm font-bold tracking-wide uppercase backdrop-blur-sm ${colors[color]}`}
	>{title}</span
>
