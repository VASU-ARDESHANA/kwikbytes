---
import { getCollection } from "astro:content";
import { siteLang, siteCurrency } from "~/data/config";

const plates = await getCollection("plates");
const getImageSrc = (image?: string | { src?: string }) =>
	typeof image === "string" ? image : image?.src;
---

<div id="menu-categories" class="max-w-6xl mx-auto px-4 mt-6 mb-8 scroll-mt-24">
	<div class="flex items-center gap-4 mb-6">
		<div class="h-px bg-gray-200 flex-1"></div>
		<h2 class="text-xs font-black text-gray-400 uppercase tracking-widest text-center">Menu Categories</h2>
		<div class="h-px bg-gray-200 flex-1"></div>
	</div>
	
	<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2.5 sm:gap-3">
		{
			plates.map((plate) => (
				<a
					href={`#${plate.data.slug}`}
					class="flex items-center justify-center min-h-[48px] px-3 py-2 rounded-xl bg-white border border-gray-200 shadow-sm text-center font-bold text-gray-700 text-sm hover:bg-brand-green hover:text-white hover:border-brand-green hover:shadow-md transition-all active:scale-95 group"
				>
					<span class="line-clamp-2">{plate.data.prettyName}</span>
				</a>
			))
		}
	</div>
</div>

<div class="max-w-6xl mx-auto px-4 grid grid-cols-1 gap-y-10 pb-16">
	{
		plates.map((plate) => (
			<section
				id={plate.data.slug}
				class="scroll-mt-24 relative"
				data-category-section={plate.data.slug}
			>
				{/* Stunning Dynamic Category Header with Background Image */}
				<div class="mb-6 relative rounded-2xl overflow-hidden bg-brand-green flex flex-col items-center justify-center min-h-[140px] sm:min-h-[180px] shadow-md">
					{plate.data.background && (
						<img 
							src={getImageSrc(plate.data.background)} 
							alt={plate.data.prettyName} 
							class="absolute inset-0 w-full h-full object-cover scale-105"
							loading="lazy"
						/>
					)}
					<div class="absolute inset-0 bg-black/[0.01]"></div>
					<div class="absolute inset-0 bg-gradient-to-t from-black/10 to-transparent"></div>
					
					<div class="relative z-10 text-center px-4 py-6 w-full h-full flex flex-col items-center justify-center mt-auto">
						<h3 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight drop-shadow-[0_4px_4px_rgba(0,0,0,0.8)] mb-2">
							{plate.data.prettyName}
						</h3>
						{plate.data.description && (
							<p class="text-sm sm:text-base text-white font-bold max-w-2xl text-balance drop-shadow-[0_2px_2px_rgba(0,0,0,1)] mb-2">
								{plate.data.description}
							</p>
						)}

						{plate.data.varieties && plate.data.varieties.length > 0 && (
							<div class="flex flex-wrap justify-center gap-2 mt-2">
								{plate.data.varieties.map(v => (
									<div class="flex items-center gap-1.5 bg-black/50 backdrop-blur-md border border-white/20 px-3 py-1.5 rounded-full shadow-lg">
										<span class="text-brand-orange font-black text-[10px] uppercase tracking-wider">{v.name}:</span>
										<span class="text-gray-200 font-bold text-[10px]">{v.description}</span>
									</div>
								))}
							</div>
						)}
					</div>
				</div>

				{/* Grid of Interactive Modern Cards */}
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-5">
					{plate.data.plates.map((item) => (
						<div class="group bg-white rounded-2xl p-4 sm:p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-brand-orange/30 transition-all duration-300 flex flex-col justify-between h-full overflow-hidden">
							
							{item.image && (
								<div class="w-[calc(100%+2.5rem)] h-36 -mt-4 -mx-4 sm:-mt-5 sm:-mx-5 mb-4 overflow-hidden bg-gray-50 relative">
									<img src={getImageSrc(item.image)} alt={item.name} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
									<div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
								</div>
							)}

							<div class="mb-4">
								<h4 class="font-black text-lg sm:text-xl text-gray-800 group-hover:text-brand-green transition-colors duration-300 mb-1 leading-tight">
									{item.name}
								</h4>
								{item.description && (
									<p class="text-xs sm:text-sm text-gray-500 font-medium leading-tight">
										{item.description}
									</p>
								)}
							</div>

							<div class="flex items-end justify-between gap-3 mt-auto border-t border-dashed border-gray-200 pt-3">
								
								{/* Pricing Logic to properly label Regular vs Jumbo/Varieties */}
								{item.price2 ? (
									<div class="flex gap-2 w-full justify-between items-center">
										{/* First Size */}
										<div class="flex flex-col">
											<span class="text-[9px] sm:text-[10px] font-black uppercase text-gray-400 tracking-widest leading-none mb-1">
												{plate.data.varieties?.[0]?.name || "Regular"}
											</span>
											<span class="font-black text-base sm:text-lg text-brand-green leading-none">
												{new Intl.NumberFormat(siteLang, { style: "currency", currency: siteCurrency, minimumFractionDigits: 0 }).format(item.price)}
											</span>
										</div>
										<div class="w-px h-6 bg-gray-200"></div>
										{/* Second Size */}
										<div class="flex flex-col text-right">
											<span class="text-[9px] sm:text-[10px] font-black uppercase text-brand-orange tracking-widest leading-none mb-1">
												{plate.data.varieties?.[1]?.name || "Jumbo"}
											</span>
											<span class="font-black text-base sm:text-lg text-brand-orange leading-none">
												{new Intl.NumberFormat(siteLang, { style: "currency", currency: siteCurrency, minimumFractionDigits: 0 }).format(item.price2)}
											</span>
										</div>
									</div>
								) : (
									<div class="w-full flex justify-end">
										<span class="font-black text-lg sm:text-xl text-brand-green bg-brand-green/5 px-3 py-1.5 rounded-lg text-right">
											{new Intl.NumberFormat(siteLang, { style: "currency", currency: siteCurrency, minimumFractionDigits: 0 }).format(item.price)}
										</span>
									</div>
								)}

							</div>
						</div>
					))}
				</div>


			</section>
		))
	}
</div>

<!-- Floating Action Button (Back to Categories) -->
<a 
	href="#menu-categories" 
	id="back-to-categories-btn"
	class="fixed bottom-6 right-6 lg:bottom-10 lg:right-10 z-50 bg-brand-orange text-white px-6 py-3.5 rounded-full shadow-[0_8px_30px_rgba(217,119,6,0.3)] opacity-0 translate-y-10 pointer-events-none transition-all duration-300 hover:bg-orange-600 hover:-translate-y-1 hover:shadow-[0_15px_40px_rgba(217,119,6,0.4)] active:scale-95 flex items-center gap-2 font-black uppercase tracking-widest text-sm"
	aria-label="Back to Categories"
>
	<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
	</svg>
	<span>Categories</span>
</a>

<script>
  document.addEventListener("astro:page-load", () => {

    const HEADER_OFFSET = 96;
    const DURATION = 700;

    function easeInOutQuart(t: number): number {
      return t < 0.5 ? 8 * t * t * t * t : 1 - Math.pow(-2 * t + 2, 4) / 2;
    }

    function smoothScrollTo(targetEl: Element) {
      const start = window.scrollY;
      const end =
        targetEl.getBoundingClientRect().top + window.scrollY - HEADER_OFFSET;
      const distance = end - start;
      let startTime: number | null = null;

      function step(timestamp: number) {
        if (!startTime) startTime = timestamp;
        const elapsed = timestamp - startTime;
        const progress = Math.min(elapsed / DURATION, 1);
        window.scrollTo(0, start + distance * easeInOutQuart(progress));
        if (progress < 1) requestAnimationFrame(step);
      }

      requestAnimationFrame(step);
    }

    // All anchor links
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        const href = (this as HTMLAnchorElement).getAttribute("href");
        if (!href || href === "#") return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          smoothScrollTo(target);
        }
      });
    });

    // Floating back-to-categories button
    const backBtn = document.getElementById("back-to-categories-btn");
    const categoriesSection = document.getElementById("menu-categories");

    if (backBtn && categoriesSection) {
      const toggleButton = () => {
        const past =
          window.scrollY >
          categoriesSection.offsetTop + categoriesSection.offsetHeight + 100;
        backBtn.classList.toggle("opacity-0", !past);
        backBtn.classList.toggle("translate-y-10", !past);
        backBtn.classList.toggle("pointer-events-none", !past);
      };

      window.addEventListener("scroll", toggleButton, { passive: true });
      toggleButton();

      backBtn.addEventListener("click", (e) => {
        e.preventDefault();
        smoothScrollTo(categoriesSection);
      });
    }
  });
</script>
